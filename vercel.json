{
  "version": 2,
  "buildCommand": "cd backend && npx prisma generate && npx prisma migrate deploy && cd .. && cd frontend && npm run build",
  "builds": [
    {
      "src": "backend/src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["backend/prisma/**"]
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/\\.well-known/(oauth-authorization-server|oauth-protected-resource|openid-configuration)(.*)",
      "dest": "backend/src/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "backend/src/index.ts"
    },
    {
      "src": "/(students|subjects)/([^/]+?)/?",
      "has": [{ "type": "header", "key": "rsc", "value": "1" }],
      "dest": "/frontend/$1/[id].rsc?nxtPid=$2"
    },
    {
      "src": "/(students|subjects)/([^/]+?)/?",
      "dest": "/frontend/$1/[id]?nxtPid=$2"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}